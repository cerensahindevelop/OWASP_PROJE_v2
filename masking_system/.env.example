# Bu dosya bir SABLON'dur - gercek degerleri iceren ".env" dosyasini olusturmak
# icin kopyalayin:
#
#   cp .env.example .env
#
# ve asagidaki degerleri kendi ortaminiza gore doldurun. ".env" dosyasi
# version control'e girmez (.gitignore). masking_service/app/core/config.py
# bu dosyayi dogrudan okur.

# --- SQLite veritabani ---
# Ayri bir DB sunucusu/servisi GEREKMEZ - tek bir dosyaya yazilir. Goreli
# verilirse bu .env ile ayni dizine (repo koku) gore cozumlenir. Dosya
# yoksa `alembic upgrade head` ile otomatik olusturulur.
DB_PATH=masking.db
# Bu DB ve yedekleri orijinal hassas degerlerin ACIK METIN kopyalarini da
# icerir. Sifreleme anahtari olmadan okunabilirler. Yalnizca uygulama servis
# hesabi/yetkili yoneticiler erismeli; DB dizini WEB_ALLOWED_ROOTS veya
# indirilebilir cikti dizinlerinin altinda olmamalidir. SQLite -wal/-shm
# dosyalari ve yedekleri de ayni erisim politikasina tabidir.

# --- Katman 2 Presidio / spaCy ---
# Intra ortamda model onceden kurulmus olmalidir veya kurum artifact
# repository/wheelhouse uzerinden saglanmalidir (bkz. README.md "Intra
# ortamda sifirdan kurulum").
PRESIDIO_LANGUAGE=en
PRESIDIO_SPACY_MODEL=en_core_web_lg
PRESIDIO_USE_BUILTIN_RECOGNIZERS=true
# PERSON/ORGANIZATION/DATE_TIME/LOCATION/NRP gibi dogal-dil kategorileri icin
# Shannon entropy (bit/karakter) esigi - bir bulgunun degeri bu esigin
# USTUNDEYSE (rastgele/yuksek-entropili gorunuyorsa, orn. bir API key/base64
# blob) bu kategoriler o bulguya uygulanmaz. Varsayilan 3.5, koda dokunmadan
# ayarlanabilir.
# PRESIDIO_ENTROPY_THRESHOLD=3.5

# --- Sifreleme anahtari ---
# value_mappings tablosundaki orijinal hassas degerler (IP, e-posta, secret,
# proje adi vb.) bu anahtarla sifrelenir. ZORUNLUDUR - varsayilani yoktur,
# tanimlanmazsa uygulama baslamaz. Asagidaki komutla yeni bir anahtar uretin:
#
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#
# UYARI: Anahtari degistirmek, o ana kadar sifrelenmis TUM kayitlarin geri
# donusturulmesini imkansiz hale getirir. Production'da anahtari guvenli bir
# secret yoneticisinde (Vault, AWS Secrets Manager, vb.) saklayin ve asla
# kod/repo icine yazmayin.
SECURITY_ENCRYPTION_KEY=CHANGE_ME

# --- vLLM LLM entegrasyonu ---
# Sabit formati olmayan (kisi adi, adres vb.) hassas verileri regex'in
# yaninda taramak icin vLLM'in OpenAI-uyumlu sunucusunu kullanir (bkz.
# masking_service/app/services/llm_recognizer.py). Sunucuyu kurum-ici/lokal
# olarak baslatmak icin orn.:
#   vllm serve <model-yolu-veya-adi> --port 8000 --served-model-name CHANGE_ME
#
# Katmanin kendisi kill-switch ile korunur: VLLM_ENABLED=false iken vLLM'e
# hicbir istek atilmaz ve VLLM_HOST/VLLM_MODEL zorunlu degildir. True
# yaparsaniz baglanti tamamen bu .env degerlerinden yonetilir.
# Kodda varsayilan KAPALIDIR (VLLM_ENABLED tanimlanmazsa false); bu sablon
# ise katmani ACAR. VLLM_HOST/VLLM_MODEL kurulumdaki gercek sunucuya gore
# doldurulmali - CHANGE_ME ile birakilirsa uygulama baslarken acikca hata verir.
VLLM_ENABLED=true
VLLM_HOST=http://vllm.intra.local:8000
VLLM_MODEL=CHANGE_ME
# Intra ve yerel model farkli olabilir. Sunucunun served-model-name degerini kullanin.
# Desteklenen tum metin dosyalari LLM ile taranir; kapsam disi dosyalar gonderilmez.

# `vllm serve` komutuna verilen model adi/yolu ya da --served-model-name
# ile birebir ayni olmalidir.
# VLLM_API_KEY=CHANGE_ME
# vLLM sunucusu `--api-key` ile baslatildiysa yukaridaki satiri doldurun
# (Authorization: Bearer basligi olarak gonderilir); korumasiz sunucuda bos/
# yorum satiri olarak birakilabilir.

# --- Ortak uygulama baslangic profili (Ollama + vLLM) ---
# Parallel:1 nedeniyle guvenli ortak concurrency=1; 2 ancak yuk testiyle.
# Buyuk modeller donanima gore tek dosya basina onlarca saniye ila birkac
# dakika surebilir - kendi ortaminizda olcup ayarlayin.
# VLLM_TIMEOUT_SECONDS=200
# VLLM_MAX_FILE_CHARS=6000
# VLLM_CHUNK_OVERLAP_CHARS=500
# Yanit token tavani. Asilirsa (finish_reason=length) chunk en fazla 3 kez
# ikiye bolunup yeniden taranir; yine kesilirse dosya karantinaya gider.
VLLM_MAX_TOKENS=2048
# Qwen3 gibi thinking modlu modellerde (vLLM) true: <think> ciktisi max_tokens'i tuketmesin.
VLLM_DISABLE_THINKING=true
# VLLM_SEED=42
# VLLM_MAX_CONCURRENT_REQUESTS=1
# Tespit ve audit tum chunk'lari tarar; hata/kesilme karantinaya gider.
# HTTP timeout yerel kuyruktan SONRA baslar. Worker/CLI kotalari ayri toplanir.
# Zaman asimi/baglanti/429/5xx hatalarinda YALNIZCA basarisiz chunk bu kadar
# kez yeniden denenir (0-3). Sema/parse/kesilme hatalari yeniden denenmez.
# VLLM_TRANSIENT_RETRIES=1
# Ayni anda hazirlanan dosya sayisi (LLM istek siniri yukaridaki
# VLLM_MAX_CONCURRENT_REQUESTS ile ayrica korunur).
# VLLM_FILE_BATCH_SIZE=8

# Qwen3.x thinking kapaliyken greedy cozumde model ayni bulguyu tekrarlayip
# max_tokens'i doldurabilir (hata: finish_reason=length ... donguye girdi).
# Bu durumda 1.5 deneyin (Qwen'in thinking-kapali onerisi). 0 = gonderilmez.
# DIKKAT: ceza modelin o ana kadar URETTIGI token'lara uygulanir. Ayni oneki
# paylasan degerler (orn. iki host adi) ya da tekrar eden tip etiketleri
# cezalanir; birebir kopyalanmasi gereken deger bozulursa metinde dogrulanamaz
# ve SESSIZCE atilir (recall kaybi). Yalnizca loglarda "donguye girdi" ipucu
# goruluyorsa acin ve oncesi/sonrasi altin kume olcumuyle (canary satiri)
# dogrulayin: scripts/measure_golden.py --llm real
# VLLM_PRESENCE_PENALTY=0

# Hazir profil: ollama-dev | vllm-intra. Yalnizca bu dosyada acikca verilmemis
# VLLM_* alanlarini doldurur; tek tek verilen deger her zaman onceliklidir.
# VLLM_PROFILE=vllm-intra

# Katman 1'in (sozluk/regex) kesin bulgulari LLM'e gecici yer tutucuyla gider:
# model bilinen degerleri tekrar listelemez (cikti token'i/kesilme azalir).
# VLLM_REDACT_KNOWN_FINDINGS=true
# Bu uzunluktan kisa LLM bulgulari otomatik maskelenmez (guven 'dusuk'e iner).
# VLLM_MIN_AUTO_MASK_CHARS=3
# false: hicbir katmanin degistirmedigi ve LLM tespiti hatasiz biten dosyalar
# ikinci LLM denetimine gonderilmez (hizli, ama ikinci bagimsiz kontrol kalkar).
# VLLM_AUDIT_UNCHANGED_FILES=true
# Bir dosya bu kadar ya da daha fazla LLM parcasina bolunuyorsa (ya da
# gizlenemeyen kodlanmis veri iceriyorsa) islem kaydina uyari yazilir. 0 = kapali.
# Export oncesi tahmin: python -m app.cli llm-is-yuku --kaynak <proje>
# VLLM_WARN_CHUNKS_PER_FILE=10
# vLLM tarafinda: `vllm serve ... --enable-prefix-caching` sabit sistem promptu
# onekini onbellege alir ve ilk token gecikmesini dusurur.

# --- Onerilen kurum ici vLLM baslangic degerleri (Faz 1 onerisi) ---
# Varsayilan olarak KAPALI (yorum satiri). Acmadan once asagidaki benchmark ile
# kendi GPU/modelinizde dogrulayin; gerekceler icin bkz.
# diagnostics/faz1-llm-altyapi-onerileri.md
#
# VLLM_PROFILE=vllm-intra            # eszamanlilik 4, batch 16, max_tokens 2048,
#                                    # thinking kapali, gecici hata yeniden denemesi 2
# VLLM_MAX_CONCURRENT_REQUESTS=4     # benchmark'ta timeout/kesilme olmayan en buyuk deger;
#                                    # vLLM --max-num-seqs bundan (x backend worker) kucuk olmamali
# VLLM_MAX_TOKENS=2048               # tespit/denetim JSON yaniti; kesilme parcayi bolup yeniden tarar
# VLLM_TRANSIENT_RETRIES=2           # yalnizca timeout/baglanti/429/5xx; her deneme kendi timeout'unu kullanir
# VLLM_TIMEOUT_SECONDS=200           # olculen tek istek p99 suresinin ~3 kati; 60'tan asagi inmeyin
# VLLM_DISABLE_THINKING=true
# VLLM_PRESENCE_PENALTY=0            # yukaridaki DIKKAT notuna bakin
#
# Sunucu (vLLM) tarafi baslangic noktasi:
#   (max-model-len: 8192 parca <= 6000 karakter icin yeterli; daha buyuk parcada 16384)
#   vllm serve <model> --served-model-name <ad> --enable-prefix-caching \
#     --max-model-len 8192 --max-num-seqs 8 \
#     --default-chat-template-kwargs '{"enable_thinking": false}'
#
# Olcum (masking_service klasorunde, gercek endpoint'e yalnizca sentetik metin gider):
#   python scripts/benchmark_llm.py --concurrency 1 2 4 8 --files 16 --chars 12000 \
#     --chunk-chars 6000 --max-tokens 2048 > bench-c.json 2> bench-c.log

# --- Tarama (tum tespit katmanlari) ---
# Bu uzunluk ve ustundeki gomulu ikili veri bloklari (.resx base64 resim/ikon,
# hex dokum) LLM'e ve Presidio'ya gonderilmez; base64 ile kodlanmis okunabilir
# metin gonderilmeye devam eder. Katman 1 (sozluk/regex) yine tarar. 0 = kapali.
# SCAN_ENCODED_BLOB_MIN_CHARS=512

# --- LLM bulgularinin onay politikasi ---
# Bu guven seviyesi ve ustundeki LLM bulgulari onay beklemeden maskelenir
# (maskeleme geri donusumlu, round-trip ile dogrulanir). yuksek | orta
# "yuksek" eski davranistir: orta bulgular da onay kuyruguna duser ve
# dosyalarin buyuk kismi onay bekler.
VLLM_AUTO_MASK_MIN_CONFIDENCE=orta
# Esik altindaki (dusuk guvenli) bulgular: ignore | review
# ignore: denetim kaydina yazilir, dosya bekletilmez (maskeleme sonrasi LLM
# denetimi her dosyada yine calisir ve somut bir sizintiyi yakalar).
# review: onay kuyruguna gider, dosya karar verilene kadar bekletilir.
VLLM_LOW_CONFIDENCE_ACTION=ignore

# --- Lokal/internetli gelistirme ortaminda Ollama ile test (intra vLLM yerine) ---
# Ayri bir vLLM sunucusu kurmadan bu LLM katmanini denemek icin, internete
# cikabilen bir gelistirme makinesinde kurulu Ollama'yi (https://ollama.com)
# ayni VLLM_* ayarlariyla kullanabilirsiniz - Ollama da OpenAI-uyumlu
# /v1/chat/completions sunar, kodda (call_vllm) HICBIR DEGISIKLIK GEREKMEZ.
# Gercek bir Ollama ornegine (qwen2.5:14b) karsi canli test edildi: hem
# tespit (llm_recognizer) hem post-mask denetim (audit_reviewer) katmani
# sorunsuz calisiyor.
#
# NOT: VLLM_HOST'a "/v1" yazmaniza gerek yok - kod "/v1/chat/completions"i
# kendisi ekler; sonda "/v1" yazilirsa ayarlar yuklenirken otomatik silinir.
#
#   ollama pull qwen2.5:14b   # ya da baska bir model
#   ollama serve              # varsayilan olarak zaten 11434'te calisir
#
# VLLM_ENABLED=true
# VLLM_HOST=http://localhost:11434
# VLLM_MODEL=qwen2.5:14b
# VLLM_TIMEOUT_SECONDS=200
#
# PERFORMANS: Logda Parallel:1 goruluyorsa uygulama eszamanliligini 1 yapin.
# VLLM_MAX_CONCURRENT_REQUESTS=1
# VLLM_MAX_FILE_CHARS=6000
# VLLM_CHUNK_OVERLAP_CHARS=500
# VLLM_MAX_TOKENS=512
# Ollama servis ortami (uygulama .env'sine yazmak servisi degistirmez):
#   OLLAMA_NUM_PARALLEL=1
#   OLLAMA_CONTEXT_LENGTH=8192
# 8192 ancak sistem promptu + kurum kurallari + chunk + 512 output token
# sigiyorsa uygundur. Turkce/minified/unicode dosyalariyla token butcesini olcun.
# RAM/VRAM ve benchmark olmadan OLLAMA_NUM_PARALLEL=4 yapmayin.
# Intra Qwen/vLLM icin degerleri masking_service/scripts/benchmark_llm.py ile
# olcun; Ollama ayarlarini vLLM sunucusuna kopyalamayin.

# --- Web arayuzu (Streamlit) - 'Klasor Yolu' modu icin izinli kok dizinler ---
# Web arayuzunde kaynak/hedef olarak sunucudaki bir yolu DOGRUDAN yazabilmek
# (upload disinda) SADECE burada listelenen kok dizinlerin altinda calisir -
# bkz. masking_service/app/webapp/path_guard.py. BOS birakilirsa bu mod
# tamamen KAPALIDIR (sadece "Dosya Yukle" modu calisir); CLI bundan
# ETKILENMEZ (CLI operatoru zaten guvenilir kabul edilir, serbest yol kullanir).
# WEB_ALLOWED_ROOTS=/data/projeler,/data/disari-aktarilan

# --- Streamlit'ten ayri calisan FastAPI backend sureci ---
# Backend (uvicorn) hangi adres/portta dinleyecek (bkz. masking_service/api_app.py):
# WEB_API_HOST=127.0.0.1
# WEB_API_PORT=8001
# Streamlit'in backend'e istek atarken kullanacagi adres - host/port'tan bilerek
# TUREMEZ, intra ortamda backend farkli bir proxy/host arkasinda olabilir:
# WEB_API_BASE_URL=http://127.0.0.1:8001
# Streamlit -> backend isteklerinde beklenecek azami sure (saniye). Export
# arka plan isi olarak calisir ve arayuz ilerlemeyi sorgular, bu sure export'un
# toplam suresini sinirlamaz; unmask hala tek istektir:
WEB_API_REQUEST_TIMEOUT_SECONDS=3600
# SQL parser lehcesi: postgres, tsql, oracle, mysql, sqlite vb.
# Bos deger ortak SQLGlot gramerini kullanir; desteklenmeyen kaynaklar raporlanir.
VALIDATION_SQL_DIALECT=
# Maskelemenin sozdizimini bozdugu dosya: block (varsayilan, ciktiya alinmaz) ya da
# warn (tum gizlilik kontrollerinden gectiyse uyariyla ciktiya alinir). Otomatik
# duzeltilen dosyalar ve Java .class dosyalari her modda bloklanir.
# SYNTAX_FAILURE_ACTION=block
# Lock dosyalarinda izin listesindeki public registry host'lari (tam eslesme,
# alt alan adi kabul edilmez). Bu host'lara giden URL'ler ve paket ozetleri
# (integrity/checksum) bulgu sayilmaz; ic registry URL'leri maskelenir.
# LOCKFILE_PUBLIC_REGISTRY_HOSTS=registry.npmjs.org,registry.yarnpkg.com,pypi.org,files.pythonhosted.org,crates.io,repo.packagist.org
# Kodlama tespiti (ilk 8 KB) basarisiz oldugunda sirayla denenecek eski metin
# kodlamalari (virgulle ayrilmis). Bilinmeyen bir ad baslangicta hata verir.
# LEGACY_TEXT_ENCODINGS=cp1254,iso-8859-9
